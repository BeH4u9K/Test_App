FROM ubuntu:22.04 AS builder

ENV TZ=Europe/Moscow
ENV DEBIAN_FRONTEND=noninteractive
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    libssl-dev \
    ca-certificates \
    wget \
    gnupg \
    pkg-config \
    curl \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

RUN wget -qO - https://www.mongodb.org/static/pgp/server-6.0.asc | gpg --dearmor | tee /etc/apt/keyrings/mongodb.gpg > /dev/null \
    && echo "deb [ arch=amd64,arm64 signed-by=/etc/apt/keyrings/mongodb.gpg ] https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/6.0 multiverse" | tee /etc/apt/sources.list.d/mongodb-org-6.0.list \
    && apt-get update \
    && apt-get install -y \
        libmongoc-dev \
        libbson-dev \
        mongodb-mongosh \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y \
    openssl \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

RUN echo "Checking source files..." && \
    ls -la && \
    ls -la src/ && \
    ls -la include/ && \
    ls -la libs/

RUN git clone https://github.com/Thalhammer/jwt-cpp.git /tmp/jwt-cpp \
    && cd /tmp/jwt-cpp \
    && mkdir build && cd build \
    && cmake .. -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTS=OFF \
    && make -j$(nproc) \
    && make install \
    && rm -rf /tmp/jwt-cpp

RUN git clone https://github.com/yhirose/cpp-httplib.git /tmp/cpp-httplib \
    && mkdir -p /usr/include \
    && cp /tmp/cpp-httplib/httplib.h /usr/include/ \
    && rm -rf /tmp/cpp-httplib

RUN cat CMakeLists.txt || echo "CMakeLists.txt not found"

RUN mkdir -p build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) VERBOSE=1 && \
    ldd ./authorization_server && \
    echo "Build completed"

FROM ubuntu:22.04

ENV TZ=Europe/Moscow
ENV DEBIAN_FRONTEND=noninteractive
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt-get update && apt-get install -y \
    libssl3 \
    ca-certificates \
    curl \
    openssl \
    && rm -rf /var/lib/apt/lists/*

RUN wget -qO - https://www.mongodb.org/static/pgp/server-6.0.asc | gpg --dearmor | tee /etc/apt/keyrings/mongodb.gpg > /dev/null \
    && echo "deb [ arch=amd64,arm64 signed-by=/etc/apt/keyrings/mongodb.gpg ] https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/6.0 multiverse" | tee /etc/apt/sources.list.d/mongodb-org-6.0.list \
    && apt-get update \
    && apt-get install -y \
        libmongoc-1.0-0 \
        libbson-1.0-0 \
        libcurl4 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/build/authorization_server .
COPY --from=builder /app/config ./config

RUN mkdir -p logs

RUN mkdir -p config && \
    echo '{}' > config/config.json

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8080

RUN echo '#!/bin/bash\n\
echo "Testing server health..."\n\
if curl -f http://localhost:8080/health 2>/dev/null; then\n\
  echo "Server is healthy"\n\
  exit 0\n\
elif curl -f http://localhost:8080 2>/dev/null; then\n\
  echo "Server is responding"\n\
  exit 0\n\
else\n\
  echo "Server is not responding"\n\
  exit 1\n\
fi' > /app/healthcheck.sh && chmod +x /app/healthcheck.sh

CMD ["./authorization_server"]